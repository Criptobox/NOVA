// NOVA v004 — Esquema de base de datos
// Agente WhatsApp + seguimiento cripto + dashboard PWA

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Contactos que escriben al agente (WhatsApp real o simulador)
model Contact {
  id        String    @id @default(cuid())
  waId      String    @unique
  name      String
  channel   String    @default("whatsapp") // whatsapp | simulador
  botPaused Boolean   @default(false) // v004: true = el dueño tomó la conversación, NOVA no responde
  createdAt DateTime  @default(now())
  lastSeen  DateTime  @default(now())
  messages  Message[]
}

// Mensajes de cada conversación
model Message {
  id        String   @id @default(cuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  role      String   // user | agent | owner | system
  kind      String   @default("text") // text | audio | image | note | alert | summary
  body      String
  meta      String? // JSON opcional (transcripción, descripción de imagen, botones, etc.)
  intent    String? // v004: intención detectada (para métricas)
  latencyMs Int? // v004: tiempo de respuesta del agente (para métricas)
  createdAt DateTime @default(now())
}

// Alertas de precio vigiladas por el planificador (avisan por WhatsApp)
model PriceAlert {
  id        String    @id @default(cuid())
  coinId    String
  sym       String
  dir       String // above | below
  price     Float
  on        Boolean   @default(true)
  fired     Boolean   @default(false)
  firedAt   DateTime?
  createdBy String? // waId del contacto si la creó el bot
  createdAt DateTime  @default(now())
}

// Portafolio cripto (global, gestionado desde el dashboard o el bot)
model Holding {
  id        String   @id @default(cuid())
  coinId    String   @unique
  sym       String
  name      String
  amt       Float    @default(0)
  createdAt DateTime @default(now())
}

// Mensajes programados: recordatorios y resumen diario de cripto
model ScheduledJob {
  id        String    @id @default(cuid())
  kind      String // reminder | summary
  label     String
  body      String
  target    String    @default("owner") // owner | all | waId concreto
  when      DateTime
  repeat    String    @default("none") // none | daily
  lastRun   DateTime?
  on        Boolean   @default(true)
  createdAt DateTime  @default(now())
}

// Ajustes únicos del agente (singleton id="nova")
model Setting {
  id               String   @id @default("nova")
  persona          String   @default("profesional") // profesional | casual | creativa | tecnica
  mode247          Boolean  @default(true)
  startHour        Int      @default(8)
  endHour          Int      @default(22)
  maxMsgsPerMin    Int      @default(20)
  ownerWa          String   @default("")
  aiEnabled        Boolean  @default(true)
  dailySummaryOn   Boolean  @default(false)
  dailySummaryHour Int      @default(9)
  waToken          String   @default("")
  waPhoneId        String   @default("")
  waVerifyToken    String   @default("nova-verify")
  vapidPub         String   @default("") // v006: clave pública Web Push (avisos al dueño)
  vapidPriv        String   @default("") // v006: clave privada Web Push
  updatedAt        DateTime @updatedAt
}

// v006 — Suscripciones Web Push del dashboard (aviso inmediato al pedir humano)
model PushSub {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  ua        String   @default("")
  createdAt DateTime @default(now())
}
